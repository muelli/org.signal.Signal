index d8aef44..32a279c 100644
--- a/stylesheets/_modules.scss
+++ b/stylesheets/_modules.scss
@@ -1139,6 +1139,31 @@ $message-padding-horizontal: 12px;
   color: light-dark(variables.$color-gray-60, variables.$color-gray-25);
 }
 
+// A message that was deleted for everyone, or consumed as view-once, whose contents
+// we kept locally instead of erasing. Dimmed so it reads as "this was meant to be
+// gone" without hiding what it said.
+.module-message__container--retained-after-erase {
+  opacity: 0.65;
+  filter: saturate(0.4);
+
+  &:hover,
+  &:focus-within {
+    opacity: 1;
+    filter: none;
+  }
+}
+
+.module-message__retained-notice {
+  @include mixins.font-caption;
+
+  align-items: center;
+  display: flex;
+  flex-direction: row;
+  font-style: italic;
+  margin-bottom: 2px;
+  color: light-dark(variables.$color-gray-60, variables.$color-gray-25);
+}
+
 .module-message__metadata {
   @include mixins.font-caption;
 
